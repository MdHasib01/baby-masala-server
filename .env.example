# Copy this file to .env and fill in real values.

# MongoDB connection string. Local:  mongodb://127.0.0.1:27017/baby-care
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/baby-care?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/baby-care

PORT=5000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list of frontend origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,https://babymasalabd.com,https://www.babymasalabd.com

# Demo mode (local development only): DEMO_OTP is accepted for every account and
# codes are only logged when email isn't configured. Must be false (or unset) in production.
DEMO_MODE=false

# Contacts (email) that become admins when they log in.
ADMIN_CONTACTS=admin@example.com

# SMTP for sending login codes by email (Gmail: smtp.gmail.com:465 + an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="Babymasala <support@babymasalabd.com>"

# Phone (WhatsApp/SMS) login needs an SMS provider; keep false until one is wired up.
SMS_ENABLED=false

# Google Play reviewer login: this one email always accepts REVIEW_OTP and is sent
# no email. Give both values to Google in Play Console -> App content -> App access.
REVIEW_CONTACT=playreview@babymasalabd.com
REVIEW_OTP=000000

# Cloudinary — every uploaded photo/video is stored here; the DB keeps only the URL.
# Without these, images are stored inline in MongoDB as data URLs (dev fallback).
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="baby-care"
