# Copy this file to .env and fill in real values.

# MongoDB connection string. Local:  mongodb://127.0.0.1:27017/baby-care
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/baby-care?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/baby-care

PORT=5000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list of frontend origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000,https://babymasalabd.com,https://www.babymasalabd.com

# Demo mode (local development only): DEMO_OTP is accepted for every account and
# codes are only logged when email isn't configured. Must be false (or unset) in production.
DEMO_MODE=false

# Contacts (email) that become admins when they log in.
ADMIN_CONTACTS=admin@example.com

# SMTP for sending login codes by email (Gmail: smtp.gmail.com:465 + an App Password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=you@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="Babymasala <support@babymasalabd.com>"

# Phone (WhatsApp/SMS) login needs an SMS provider; keep false until one is wired up.
SMS_ENABLED=false

# Google Play reviewer login: this one email always accepts REVIEW_OTP and is sent
# no email. Give both values to Google in Play Console -> App content -> App access.
REVIEW_CONTACT=playreview@babymasalabd.com
REVIEW_OTP=000000

# Cloudinary — every uploaded photo/video is stored here; the DB keeps only the URL.
# Without these, images are stored inline in MongoDB as data URLs (dev fallback).
CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="baby-care"

# Baby Masala store. The Shop tab shows its catalog (GET /api/products) and sends
# orders to it (POST /api/orders). Defaults to the live store.
STORE_URL=https://store.babymasalabd.com
# --- AI personas (node-agent) ---
# node-agent / Agent Console. Create a token in its console (Tokens) for "baby-care",
# allow codex and/or claude, and give it a daily quota. Server-side only - never put
# this token in the web or mobile app.
NODE_AGENT_URL=https://agent.nuktatechnologies.com
NODE_AGENT_TOKEN=
# Which CLI and model each AI task uses is picked in Admin → AI টাস্ক from the lists
# node-agent reports (GET /api/clis, /api/models/:cli); there is no CLI/model setting here.
NODE_AGENT_TIMEOUT_MS=300000

# Labeled AI personas ("<name> (AI)", created from Admin → AI ইউজার). Their automatic posts, comments
# and reactions are set up in Admin → AI টাস্ক (stored in MongoDB). These three only seed that the first time.
AI_COMMUNITY_ENABLED=false
# Share (0-100) of automatic AI posts that get an AI-generated photo (each photo takes 1-3 min).
AI_IMAGE_POST_PERCENT=40
# Asia/Dhaka hours when personas are active (start-end).
AI_ACTIVE_HOURS=8-23
