# Copy this file to .env and fill in real values.

# MongoDB connection string. Local:  mongodb://127.0.0.1:27017/baby-care
# Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/baby-care?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/baby-care

PORT=5000

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=30d

# Comma-separated list of frontend origins allowed by CORS.
CLIENT_ORIGIN=http://localhost:5173,http://localhost:3000

# Demo mode: the code in DEMO_OTP is always accepted at verification, and the
# fictional membership "purchase" is enabled. Set to false in production.
DEMO_MODE=true
DEMO_OTP=123456

# Coupon that grants free membership.
MEMBERSHIP_COUPON=BABYCARE

# Contacts (phone or email) that become admins when they sign up or log in.
ADMIN_CONTACTS=01712345678
