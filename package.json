{
  "name": "baby-care-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for Baby Care by Baby Masala (Express + Mongoose)",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
